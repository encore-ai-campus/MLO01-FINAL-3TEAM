      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "noValue": "미수집"
        },
        "overrides": []
      },
      "description": "클릭할 수 있는 단계에서 Kafka 전달, 실패, 재시도 기록을 확인합니다.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "voc-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "rawSql": "\nWITH events AS (\n    SELECT stage,count(*) FILTER(WHERE started_at BETWEEN $__timeFrom()::timestamptz AND $__timeTo()::timestamptz) AS entered,\n           count(*) FILTER(WHERE succeeded_at BETWEEN $__timeFrom()::timestamptz AND $__timeTo()::timestamptz) AS completed\n    FROM monitor.stage WHERE started_at BETWEEN $__timeFrom()::timestamptz AND $__timeTo()::timestamptz OR succeeded_at BETWEEN $__timeFrom()::timestamptz AND $__timeTo()::timestamptz\n    GROUP BY stage\n), counts AS (\n    SELECT s.stage,e.entered,e.completed,\n        e.entered IS NOT NULL OR CASE\n            WHEN s.stage IN ('compute','ready') THEN EXISTS(SELECT FROM monitor.availability WHERE step='classification' AND seen_from<=$__timeTo()::timestamptz AND seen_until>=$__timeFrom()::timestamptz) AND EXISTS(SELECT FROM monitor.availability WHERE step='embedding' AND seen_from<=$__timeTo()::timestamptz AND seen_until>=$__timeFrom()::timestamptz)\n            ELSE EXISTS (SELECT FROM monitor.availability a WHERE a.step=s.stage\n                         AND seen_from<=$__timeTo()::timestamptz AND seen_until>=$__timeFrom()::timestamptz)\n        END AS observed\n    FROM unnest(ARRAY['capture','bronze','flink','ticket','compute','ready']) s(stage) LEFT JOIN events e USING(stage)\n)\nSELECT max(CASE WHEN stage='capture' THEN CASE WHEN observed THEN '유입 ' || coalesce(entered,0)::text || '건  ·  완료 ' || coalesce(completed,0)::text || '건' ELSE '미수집' END END) AS \"capture\", max(CASE WHEN stage='bronze' THEN CASE WHEN observed THEN '유입 ' || coalesce(entered,0)::text || '건  ·  완료 ' || coalesce(completed,0)::text || '건' ELSE '미수집' END END) AS \"bronze\", max(CASE WHEN stage='flink' THEN CASE WHEN observed THEN '유입 ' || coalesce(entered,0)::text || '건  ·  완료 ' || coalesce(completed,0)::text || '건' ELSE '미수집' END END) AS \"flink\", max(CASE WHEN stage='ticket' THEN CASE WHEN observed THEN '유입 ' || coalesce(entered,0)::text || '건  ·  완료 ' || coalesce(completed,0)::text || '건' ELSE '미수집' END END) AS \"ticket\", max(CASE WHEN stage='compute' THEN CASE WHEN observed THEN '유입 ' || coalesce(entered,0)::text || '건  ·  완료 ' || coalesce(completed,0)::text || '건' ELSE '미수집' END END) AS \"compute\", max(CASE WHEN stage='ready' THEN CASE WHEN observed THEN '유입 ' || coalesce(entered,0)::text || '건  ·  완료 ' || coalesce(completed,0)::text || '건' ELSE '미수집' END END) AS \"ready\"\nFROM counts\n",
          "format": "table",
          "editorMode": "code"
        }
      ],
