    {
      "id": 20,
      "type": "table",
      "title": "미해결·복구 실패 기록",
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "noValue": "미수집"
        },
        "overrides": []
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "voc-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "rawSql": "\nSELECT stage AS \"단계\",event_id AS \"원본 키\",reason AS \"사유\",failed_at AS \"실패\",\n       recovered_at AS \"복구\",CASE WHEN recovered_at IS NULL THEN '미해결' ELSE '복구' END AS \"상태\"\nFROM monitor.failure\nWHERE failed_at BETWEEN $__timeFrom()::timestamptz AND $__timeTo()::timestamptz OR recovered_at BETWEEN $__timeFrom()::timestamptz AND $__timeTo()::timestamptz OR recovered_at IS NULL\nORDER BY failed_at DESC LIMIT 100\n",
          "format": "table",
          "editorMode": "code"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 21,
      "type": "table",
      "title": "단계 상세 · ${step:text}",
      "gridPos": {
        "x": 0,
        "y": 44,
        "w": 24,
        "h": 12
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "noValue": "—"
        },
        "overrides": []
      },
      "description": "선택한 단계의 이벤트를 최근 150건까지 표시합니다. 원본 이벤트 ID는 단계마다 같은 원본 문의를 찾는 데 쓰입니다.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "voc-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "rawSql": "\nWITH attempts AS (\n  SELECT *,lag(error) OVER ordered AS previous_error,\n         lag(request_partition) OVER ordered AS previous_partition,lag(request_offset) OVER ordered AS previous_offset\n  FROM monitor.flink_attempt WHERE started_at<=$__timeTo()::timestamptz\n    AND ${step:sqlstring} IN ('all','flink')\n  WINDOW ordered AS (PARTITION BY event_id ORDER BY started_at,attempt_id)\n), retries AS (\n  SELECT event_id,'flink' AS stage,count(*) AS retries,max(started_at) AS last_at\n  FROM attempts\n  WHERE previous_error IS NOT NULL OR (request_partition,request_offset)=(previous_partition,previous_offset)\n  GROUP BY event_id\n  UNION ALL\n  SELECT event_id,stage,retries,last_at FROM monitor.analysis_retries WHERE ${step:sqlstring} IN ('all','compute')\n), detail AS (\n  SELECT started_at AS event_at,'유입' AS activity,stage,event_id,\n         NULL::text AS topic,NULL::integer AS partition_id,NULL::bigint AS kafka_offset,NULL::bigint AS retries\n  FROM monitor.stage WHERE started_at BETWEEN $__timeFrom()::timestamptz AND $__timeTo()::timestamptz\n  UNION ALL\n  SELECT succeeded_at,'완료',stage,event_id,NULL,NULL,NULL,NULL\n  FROM monitor.stage WHERE succeeded_at BETWEEN $__timeFrom()::timestamptz AND $__timeTo()::timestamptz\n  UNION ALL\n  SELECT recorded_at,'Kafka 전달',stage,event_id,topic,partition_id,kafka_offset,NULL\n  FROM monitor.kafka_delivery WHERE recorded_at BETWEEN $__timeFrom()::timestamptz AND $__timeTo()::timestamptz AND stage IN ('capture','bronze','flink')\n  UNION ALL\n  SELECT failed_at,'실패',stage,event_id,NULL,NULL,NULL,NULL\n  FROM monitor.failure WHERE failed_at BETWEEN $__timeFrom()::timestamptz AND $__timeTo()::timestamptz AND event_id IS NOT NULL AND stage IN ('capture','bronze','ticket')\n  UNION ALL\n  SELECT last_at,'재시도',stage,event_id,NULL,NULL,NULL,retries FROM retries\n  WHERE last_at BETWEEN $__timeFrom()::timestamptz AND $__timeTo()::timestamptz\n)\nSELECT event_at AS \"이벤트 시각\",activity AS \"이벤트 종류\",\n       CASE stage WHEN 'capture' THEN '수집' WHEN 'bronze' THEN '원문 저장' WHEN 'flink' THEN 'Flink 정제' WHEN 'ticket' THEN '티켓 저장' WHEN 'compute' THEN '분류·임베딩' WHEN 'ready' THEN '결과 저장'\n           WHEN 'classification' THEN '분류' WHEN 'embedding' THEN '임베딩' END AS \"단계\",\n       event_id AS \"원본 이벤트 ID\",topic AS \"Kafka 토픽\",partition_id AS \"파티션\",kafka_offset AS \"오프셋\",\n       retries AS \"재시도 횟수\"\nFROM detail\nWHERE ${step:sqlstring} IN ('all',stage) OR (${step:sqlstring}='compute' AND stage IN ('classification','embedding'))\nORDER BY event_at DESC LIMIT 150\n",
          "format": "table",
          "editorMode": "code"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 23,
      "type": "table",
      "title": "대조가 필요한 원본 키",
      "gridPos": {
        "x": 0,
        "y": 56,
        "w": 24,
