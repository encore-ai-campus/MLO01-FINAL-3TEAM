        "overrides": []
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "voc-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "rawSql": "\nSELECT label AS \"단계\", CASE WHEN q.pending>0 OR (stage='flink' AND EXISTS(SELECT FROM monitor.availability WHERE step='bronze' AND seen_from<=$__timeTo()::timestamptz AND seen_until>=$__timeFrom()::timestamptz))\n    OR (stage='classification' AND EXISTS(SELECT FROM monitor.availability WHERE step='classification' AND seen_from<=$__timeTo()::timestamptz AND seen_until>=$__timeFrom()::timestamptz)) OR (stage='embedding' AND EXISTS(SELECT FROM monitor.availability WHERE step='embedding' AND seen_from<=$__timeTo()::timestamptz AND seen_until>=$__timeFrom()::timestamptz))\n    THEN coalesce(q.pending,0) END AS \"대기 건수\", q.oldest_seconds::integer AS \"가장 오래된 대기 (초)\"\nFROM (VALUES ('flink','원문 저장 후 Kafka 발행'),('classification','분류'),('embedding','임베딩')) AS s(stage,label)\nLEFT JOIN monitor.queue_backlog q USING(stage)\n",
          "format": "table",
          "editorMode": "code"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
