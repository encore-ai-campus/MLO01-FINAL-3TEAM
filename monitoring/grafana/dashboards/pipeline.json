    {
      "id": 20,
      "type": "table",
      "title": "분류·임베딩 모델 실패 및 복구 기록",
      "gridPos": {
        "x": 0,
        "y": 38,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "noValue": "미수집"
        },
