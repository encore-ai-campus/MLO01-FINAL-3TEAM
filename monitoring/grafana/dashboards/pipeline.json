    {
      "id": 8,
      "type": "table",
      "title": "단계별 처리 시간",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "noValue": "미수집"
        },
        "overrides": []
      },
      "description": "같은 문의에서 최초 유입과 최초 완료의 차이를 측정합니다.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "voc-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "rawSql": "\nSELECT CASE stage WHEN 'capture' THEN '수집' WHEN 'bronze' THEN '원문 저장' WHEN 'flink' THEN 'Flink 정제' WHEN 'ticket' THEN '티켓 저장' WHEN 'compute' THEN '분류·임베딩' WHEN 'ready' THEN '결과 저장' END AS \"단계\",\n       count(*) AS \"완료 표본\",\n       round(percentile_cont(0.95) WITHIN GROUP (\n           ORDER BY extract(epoch FROM (succeeded_at-started_at)))::numeric, 2) AS \"P95 (초)\"\nFROM monitor.stage\nWHERE succeeded_at BETWEEN $__timeFrom()::timestamptz AND $__timeTo()::timestamptz AND started_at<=succeeded_at\nGROUP BY stage ORDER BY array_position(ARRAY['capture','bronze','flink','ticket','compute','ready'],stage)\n",
          "format": "table",
          "editorMode": "code"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 9,
      "type": "table",
      "title": "전체 처리 시간과 30초 목표",
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "noValue": "미수집"
        },
        "overrides": []
      },
      "description": "원본 공급자 등록부터 결과 저장까지 잽니다. 등록 시각을 모르는 문의는 제외합니다.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "voc-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "rawSql": "\nWITH completed AS (\n  SELECT extract(epoch FROM ready_at-registered_at) AS seconds FROM monitor.normal_inquiry\n  WHERE ready_at BETWEEN $__timeFrom()::timestamptz AND $__timeTo()::timestamptz AND ready_at>=registered_at\n), cohort AS (\n  SELECT *, ready_at >= registered_at AND ready_at<=least(registered_at+interval '30 seconds',$__timeTo()::timestamptz) AS hit\n  FROM monitor.normal_inquiry WHERE registered_at BETWEEN $__timeFrom()::timestamptz AND $__timeTo()::timestamptz\n   AND (registered_at<=$__timeTo()::timestamptz-interval '30 seconds' OR ready_at BETWEEN registered_at AND $__timeTo()::timestamptz)\n)\nSELECT label AS \"지표\",value AS \"측정값\"\nFROM (\n  SELECT (SELECT round(percentile_cont(0.95) WITHIN GROUP(ORDER BY seconds)::numeric,2) FROM completed) AS p95,\n         CASE WHEN count(*)>0 OR EXISTS(SELECT FROM monitor.availability WHERE step='bronze' AND seen_from<=$__timeTo()::timestamptz AND seen_until>=$__timeFrom()::timestamptz) THEN count(*) FILTER(WHERE hit) END AS hits,\n         CASE WHEN count(*)>0 OR EXISTS(SELECT FROM monitor.availability WHERE step='bronze' AND seen_from<=$__timeTo()::timestamptz AND seen_until>=$__timeFrom()::timestamptz) THEN count(*) FILTER(WHERE NOT coalesce(hit,false)) END AS misses,\n         CASE WHEN count(*)>0 OR EXISTS(SELECT FROM monitor.availability WHERE step='bronze' AND seen_from<=$__timeTo()::timestamptz AND seen_until>=$__timeFrom()::timestamptz) THEN count(*) END AS total,\n         round(count(*) FILTER(WHERE hit)*100.0/nullif(count(*),0),1) AS completion\n  FROM cohort\n) metrics CROSS JOIN LATERAL (VALUES ('전체 시간 P95 (초)',p95),('30초 이내 완료 (건)',hits),\n  ('목표 미달 (건)',misses),('대상 (건)',total),('30초 내 완료율 (%)',completion)) AS v(label,value)\n",
          "format": "table",
          "editorMode": "code"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 10,
      "type": "table",
      "title": "원문과 티켓 대조",
      "gridPos": {
        "x": 0,
