      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "voc-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "rawSql": "\nSELECT CASE stage WHEN 'classification' THEN '분류 모델' WHEN 'embedding' THEN '임베딩 모델' END AS \"모델 종류\",\n       event_id AS \"원본 이벤트 ID\",\n       CASE reason WHEN 'incomplete_classification' THEN '분류 결과 일부 누락' ELSE reason END AS \"실패 사유\",\n       failed_at AS \"실패 시각\",recovered_at AS \"복구 시각\",\n       CASE WHEN recovered_at IS NULL THEN '미해결' ELSE '복구' END AS \"상태\"\nFROM monitor.failure\nWHERE stage IN ('classification','embedding')\n  AND (failed_at BETWEEN $__timeFrom()::timestamptz AND $__timeTo()::timestamptz OR recovered_at BETWEEN $__timeFrom()::timestamptz AND $__timeTo()::timestamptz OR recovered_at IS NULL)\nORDER BY failed_at DESC LIMIT 100\n",
          "format": "table",
          "editorMode": "code"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 23,
      "type": "table",
      "title": "대조가 필요한 원본 키",
      "gridPos": {
        "x": 0,
        "y": 46,
        "w": 24,
        "h": 8
