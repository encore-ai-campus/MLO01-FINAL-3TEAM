      "description": "현재 전체 원문과 티켓을 비교합니다. 대기·실패 기록은 누락 의심에서 제외합니다.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "voc-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "rawSql": "\nSELECT label AS \"대조 상태\",CASE WHEN observed THEN value END AS \"건수\"\nFROM (\n    SELECT count(*)>0 OR EXISTS(SELECT FROM monitor.availability WHERE step='bronze' AND seen_from<=$__timeTo()::timestamptz AND seen_until>=$__timeFrom()::timestamptz) AS observed,\n       count(*) FILTER(WHERE reconciliation='source_without_ticket') AS missing_ticket,\n       count(*) FILTER(WHERE reconciliation='ticket_without_source') AS missing_source,\n       coalesce(sum(extra_tickets),0) AS duplicates,\n       count(*) FILTER(WHERE reconciliation='pending') AS pending,\n       count(*) FILTER(WHERE reconciliation='unconfirmed_delivery') AS unconfirmed,\n       count(*) FILTER(WHERE reconciliation='failed') AS failed\n    FROM monitor.source_reconciliation\n) metrics CROSS JOIN LATERAL (VALUES ('티켓 없는 원문',missing_ticket),('원문 없는 티켓',missing_source),\n    ('중복 발행 티켓',duplicates),('정제 처리 요청 대기',pending),('Flink 정제 처리 대기',unconfirmed),\n    ('실패 기록 있음',failed)) AS v(label,value)\n",
          "format": "table",
          "editorMode": "code"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
