        {
          "refId": "A",
          "rawQuery": true,
          "rawSql": "\nSELECT event_id AS \"원본 키\",channel AS \"채널\",ticket_count AS \"티켓\",extra_tickets AS \"중복 발행 티켓\",\n       CASE reconciliation WHEN 'source_without_ticket' THEN '티켓 없는 원문'\n        WHEN 'ticket_without_source' THEN '원문 없는 티켓'\n        WHEN 'failed' THEN '실패 기록 있음' WHEN 'unconfirmed_delivery' THEN 'Flink 정제 처리 대기' ELSE '대조 완료' END AS \"대조 상태\"\nFROM monitor.source_reconciliation\nWHERE reconciliation IN ('source_without_ticket','ticket_without_source','failed','unconfirmed_delivery') OR extra_tickets>0\nORDER BY received_at DESC NULLS FIRST LIMIT 100\n",
          "format": "table",
          "editorMode": "code"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    }
