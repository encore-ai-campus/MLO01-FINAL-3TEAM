#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/../.."
umask 077
project=${VOC_MONITOR_PROJECT:-voc-monitoring-test}
state_dir="./.local/${project#voc-}"

export VOC_MONITOR_SECRETS_DIR="$state_dir"/secrets
export VOC_COLLECTOR_SECRETS_DIR="$VOC_MONITOR_SECRETS_DIR"
export VOC_CAPTURE_DIR="$state_dir"/capture
export VOC_EVAL_DIR="$state_dir"/eval
export VOC_MONITOR_RUNTIME=true VOC_GRAFANA_ANONYMOUS=true
export VOC_GRAFANA_PORT=${VOC_GRAFANA_PORT:-23000} VOC_PROMETHEUS_PORT=${VOC_PROMETHEUS_PORT:-29090}
export VOC_FLINK_PORT=${VOC_FLINK_PORT:-28081} VOC_DESK_PORT=${VOC_DESK_PORT:-28082}
compose=(docker compose -p "$project" -f compose.yaml -f src/monitoring/compose.monitoring.yaml -f src/monitoring/compose.monitoring-test.yaml)

mode=${1:-start}
if (( $# > 0 )); then shift; fi
case "$mode" in
  start)
    mkdir -p "$VOC_MONITOR_SECRETS_DIR" "$VOC_CAPTURE_DIR" "$VOC_EVAL_DIR"
    for secret in postgres-password django-secret-key reader-password grafana-password staff-password; do
      if [[ ! -s "$VOC_MONITOR_SECRETS_DIR/$secret" ]]; then
        openssl rand -hex 24 > "$VOC_MONITOR_SECRETS_DIR/$secret"
      fi
    done
    exec "${compose[@]}" up -d --build --wait --wait-timeout 180 \
      grafana classify embed publish db-worker taskmanager ticket-desk
    ;;
  seed)
    "${compose[@]}" exec -T ticket-desk python -c \
      'from pathlib import Path; from argon2 import PasswordHasher; print(PasswordHasher().hash(Path("/run/secrets/test_staff_password").read_text().strip()))' \
      | "${compose[@]}" exec -T fixture python /opt/voc-test-fixture.py seed
    ;;
  candidates)
    company=$("${compose[@]}" exec -T postgres psql -XAt -U voc -d voc -v ON_ERROR_STOP=1 \
      -c "SELECT company_uuid FROM public.company WHERE email_domain='voc-test.invalid'")
    if [[ -z "$company" ]]; then
      echo "먼저 src/monitoring/monitoring-test seed를 실행하세요." >&2
      exit 1
    fi
    exec "${compose[@]}" exec -T ticket-desk python manage.py training_candidates "$company" "$@"
    ;;
  password) cat "$VOC_MONITOR_SECRETS_DIR/staff-password" ;;
  status) exec "${compose[@]}" ps -a ;;
  stop) exec "${compose[@]}" stop ;;
  compose) exec "${compose[@]}" "$@" ;;
  *)
    echo "사용법: src/monitoring/monitoring-test {start|seed|candidates|password|status|stop|compose}" >&2
    exit 2
    ;;
esac
