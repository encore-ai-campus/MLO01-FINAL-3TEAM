    {
      "id": 8,
      "type": "table",
      "title": "단계별 처리 시간",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "noValue": "-"
        },
        "overrides": []
      },
      "description": "각 구간의 완료 시각을 기준으로 집계합니다. Kafka 전달 기록은 발행 트랜잭션의 시각입니다.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "voc-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "rawSql": "\nWITH samples(stage, seconds) AS (\n    SELECT 'publish',extract(epoch FROM published_at-queued_at)\n    FROM voc_monitor.standardization WHERE published_at BETWEEN $__timeFrom()::timestamptz AND $__timeTo()::timestamptz AND published_at>=queued_at\n    UNION ALL\n    SELECT 'silver',extract(epoch FROM standardized_at-published_at)\n    FROM voc_monitor.standardization WHERE standardized_at BETWEEN $__timeFrom()::timestamptz AND $__timeTo()::timestamptz AND standardized_at>=published_at\n)\nSELECT label AS \"측정 구간\",count(seconds) AS \"완료 표본\",\n       round(percentile_cont(0.95) WITHIN GROUP(ORDER BY seconds)::numeric,2) AS \"P95 (초)\"\nFROM (VALUES ('publish','요청 대기 → Kafka 전달'),('silver','Kafka 전달 → Silver 저장')) AS stages(stage,label)\nLEFT JOIN samples USING(stage)\nGROUP BY stages.stage,label\nORDER BY stages.stage\n",
          "format": "table",
          "editorMode": "code"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 9,
      "type": "table",
      "title": "전체 처리 시간과 30초 목표",
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "noValue": "미수집"
        },
        "overrides": []
      },
      "description": "선택한 기간에 수집 기록이 없으면 건수는 0입니다. 수집 기록이 있으면 분류·임베딩 최종 완료 시각이 없어 미수집으로 표시합니다.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "voc-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "rawSql": "\nSELECT label AS \"지표\",\n       CASE WHEN NOT EXISTS (\n           SELECT 1 FROM voc_monitor.diagnostics WHERE stage='capture' AND observed_at BETWEEN $__timeFrom()::timestamptz AND $__timeTo()::timestamptz\n       ) THEN empty_value ELSE '미수집' END AS \"측정값\"\nFROM (VALUES (1,'전체 시간 P95 (초)','-'),(2,'30초 이내 완료 (건)','0'),(3,'목표 미달 (건)','0'),\n             (4,'대상 (건)','0'),(5,'30초 내 완료율 (%)','0%')) AS metrics(position,label,empty_value)\nORDER BY position\n",
          "format": "table",
          "editorMode": "code"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 10,
      "type": "table",
      "title": "원문과 티켓 대조",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "noValue": "미수집"
        },
        "overrides": []
      },
      "description": "수집 원문을 업무 티켓과 대조합니다. Flink 정제 처리 대기는 발행 이후 현재 Silver 저장을 확인하지 못한 건입니다.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "voc-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "rawSql": "\nSELECT label AS \"대조 상태\",CASE WHEN observed THEN value END AS \"건수\"\nFROM (\n    SELECT count(*)>0 AS observed,\n       count(*) FILTER(WHERE reconciliation='source_without_ticket') AS missing_ticket,\n       count(*) FILTER(WHERE reconciliation='ticket_without_source') AS missing_source,\n       coalesce(sum(extra_tickets),0) AS duplicates,\n       count(*) FILTER(WHERE reconciliation='pending') AS pending,\n       count(*) FILTER(WHERE reconciliation='unconfirmed_delivery') AS unconfirmed,\n       count(*) FILTER(WHERE reconciliation='projection_issue') AS projection_issues\n    FROM voc_monitor.source_reconciliation\n) metrics CROSS JOIN LATERAL (VALUES ('티켓 없는 문의 원문',missing_ticket),('원문 없는 수집 티켓',missing_source),\n    ('중복 발행 티켓',duplicates),('정제 처리 요청 대기',pending),('Flink 정제 처리 대기',unconfirmed),\n    ('티켓 생성 보류',projection_issues)) AS v(label,value)\n",
          "format": "table",
          "editorMode": "code"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 11,
      "type": "table",
      "title": "AI 모델 분석 대기",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "noValue": "미수집"
        },
        "overrides": []
      },
      "description": "발행 전인 감성·카테고리 작업을 셉니다. 한 티켓에서 두 작업이 생길 수 있습니다. 임베딩 대기 기록은 아직 연결되지 않았습니다.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "voc-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "rawSql": "\nSELECT label AS \"단계\", q.pending AS \"대기 작업\",\n       CASE WHEN q.pending=0 THEN '-' ELSE q.oldest_seconds::integer::text END AS \"가장 오래된 대기 (초)\"\nFROM (VALUES ('classification','분류 요청'),('embedding','임베딩')) AS s(stage,label)\nLEFT JOIN voc_monitor.queue_backlog q USING(stage)\n",
          "format": "table",
          "editorMode": "code"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
