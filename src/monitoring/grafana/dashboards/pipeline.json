          "noValue": "미수집"
        },
        "overrides": []
      },
      "description": "단계를 눌러 DB에 저장된 수집·Kafka 전달·검토 기록을 확인합니다.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "voc-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "rawSql": "\nWITH capture AS (\n    SELECT count(*) AS count FROM voc_monitor.diagnostics WHERE stage='capture' AND observed_at BETWEEN $__timeFrom()::timestamptz AND $__timeTo()::timestamptz\n), silver AS (\n    SELECT count(*) AS count FROM voc_monitor.diagnostics\n    WHERE stage='flink' AND activity='Silver DB 저장' AND observed_at BETWEEN $__timeFrom()::timestamptz AND $__timeTo()::timestamptz\n)\nSELECT CASE WHEN i.bronze>0 THEN '기록된 수집 ' || c.count || '건' ELSE '미수집' END AS capture,\n       CASE WHEN i.bronze>0 THEN '현재 원문 ' || i.bronze || '건' ELSE '미수집' END AS bronze,\n       CASE WHEN s.count>0 THEN 'Silver 저장 ' || s.count || '건' ELSE '미수집' END AS flink,\n       CASE WHEN i.bronze>0 THEN '현재 원문 연결 ' || i.tickets || '건' ELSE '미수집' END AS ticket,\n       CASE WHEN i.queued IS NOT NULL THEN '현재 분류 대기 ' || i.queued || '건' ELSE '미수집' END AS compute,\n       '미수집' AS ready\nFROM voc_monitor.inventory i CROSS JOIN capture c CROSS JOIN silver s\n",
          "format": "table",
          "editorMode": "code"
        }
      ],
